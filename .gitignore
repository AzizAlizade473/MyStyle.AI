# --- Security (The most important part) ---
.env
.env.*
!env.example
*.pem
*.key

# --- Python & Django ---
__pycache__/
*.py[cod]
*$py.class
db.sqlite3
local_settings.py

# --- Docker & Local Data ---
# Ignore the actual data stored in volumes
postgres_data/
media_data/

# We want to keep the folders if they are empty, but ignore content? 
# Usually for docker volumes, we ignore the folder entirely.
# If you want to keep the folder structure but ignore content, use:
# media_data/*
# !media_data/.gitkeep

# --- IDEs & Editors ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
env
# --- Frontend ---
# If you ever add node_modules for JS libraries
node_modules/
npm-debug.log
yarn-error.log

# --- Static files ---
# In production, collectstatic puts files here. 
# You generally don't commit the collected static files.
backend/static_root/